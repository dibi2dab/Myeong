{
  "name": "myeong",
  "version": "1.0.0",
  "description": "Myeong (命) - deterministic Four Pillars (사주팔자) calculation and rule-based interpretation. Static web app (GitHub Pages) + personal daily fortune e-mail (GitHub Actions).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "saju",
    "four-pillars",
    "bazi",
    "korean-calendar",
    "solar-terms",
    "deterministic"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "email": "tsx email/main.ts",
    "tools:hko": "tsx tools/make-hko-fixture.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
